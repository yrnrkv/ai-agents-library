# Google Gemini (recommended for Hong Kong — free tier / quotas in AI Studio)
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternative env name also supported:
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
# Cap total wall time for Gemini retries/fallbacks (seconds). Keep under your host's HTTP limit.
GEMINI_TOTAL_BUDGET_SEC=55
# Per-call ceiling for cloud LLM HTTP (Gemini/Groq/OpenAI); also used for bounded invoke wrapper.
CLOUD_LLM_PER_CALL_TIMEOUT=40
# Floor for each Gemini call timeout; prevents accidental ultra-low values (for example 6s).
GEMINI_MIN_CALL_TIMEOUT=20
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: OpenAI / compatible APIs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (development)
OLLAMA_BASE_URL=http://localhost:11434
# Max seconds for a single local Ollama LangChain invoke (model selection probes use a lower value).
OLLAMA_INVOKE_TIMEOUT=60

# Skip HTTP probes to Ollama (faster health checks). On Render, probes are skipped
# automatically when RENDER=true. Set SKIP_OLLAMA_PROBE=1 locally to mimic PaaS.
SKIP_OLLAMA_PROBE=
